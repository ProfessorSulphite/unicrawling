# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Optional. Enables the domain-scoped Exa fallback that recovers a missing
# application_portal_url. Without it the pipeline still runs and simply leaves
# that field null rather than guessing.
EXA_API_KEY=
# NotebookLM authentication is handled by the notebooklm CLI's own credential
# store, not by this file. Authenticate once:
#     notebooklm auth login
# The pipeline then opens a session via NotebookLMClient.from_storage().
