# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Optional. Enables the domain-scoped Exa fallback that recovers a missing
# application_portal_url. Without it the pipeline still runs and simply leaves
# that field null rather than guessing.
EXA_API_KEY=
# NotebookLM authentication is handled by the notebooklm CLI's own credential
# store, not by this file. Authenticate once:
#     notebooklm auth login
# The pipeline then opens a session via NotebookLMClient.from_storage().

# Everything else is configured in src/config.py rather than here: workspace
# paths, crawl thresholds, the daily NotebookLM budget, and the audit coverage
# floors that gate a push. There are no vector-store credentials -- Qdrant and
# Pinecone were removed, and Supabase is not wired up yet.

# Supabase push (C29). Both required only for `cli.py sync --no-dry-run`;
# the pipeline and every other command run fine without them.
# Apply resources/supabase_schema.sql to the project first.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
