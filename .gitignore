# Environment & Secrets
.env
*.env

# Python & IDE cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.vscode/
.claude/

# Runtime data -- crawled links, per-uni outputs and pipeline state are all
# regenerated by a run. config.ensure_directories() recreates the tree on import,
# so no .gitkeep files are needed. Pre-refactor contents live in tag `pre-refactor`.
data/

# Runtime logs
loggings/*.log
loggings/*.jsonl
loggings/single_logs/*.json
loggings/complete_logs/*.json
loggings/notebook_logs/*.json
src/loggings/*.log
outputs_backup*

# Temporary link extracts & scratch
extracted_links.txt
extracted_links_detailed.txt

# OS / Editor files
.DS_Store
*.tmp
