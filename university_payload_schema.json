{
  "$defs": {
    "ApplicationStatus": {
      "enum": [
        "open",
        "closed",
        "rolling",
        "upcoming"
      ],
      "title": "ApplicationStatus",
      "type": "string"
    },
    "ContactInfo": {
      "properties": {
        "official_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Official Email"
        },
        "phone_numbers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Phone Numbers",
          "type": "array"
        },
        "physical_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Physical Address"
        },
        "admissions_office_location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Admissions Office Location"
        },
        "sub_campuses_contact": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SubCampusContact"
          },
          "title": "Sub Campuses Contact",
          "type": "array"
        }
      },
      "title": "ContactInfo",
      "type": "object"
    },
    "DegreeLevel": {
      "description": "The four levels a counselling student can actually apply to (C17).\n\nReplaces undergraduate / graduate / postgraduate_phd, which conflated a\ntaught masters with an MPhil and had no home at all for the PGDs and\ndiplomas that make up a large share of Pakistani enrolment. Post-doctoral\nis deliberately absent: it is a research appointment, not a programme.\nLegacy values still coerce -- see ProgramItem._coerce_degree_level.",
      "enum": [
        "bachelors",
        "masters",
        "phd",
        "diploma"
      ],
      "title": "DegreeLevel",
      "type": "string"
    },
    "EligibilityRequirements": {
      "properties": {
        "minimum_marks_percentage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Marks Percentage"
        },
        "entry_tests_accepted": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Entry Tests Accepted",
          "type": "array"
        },
        "aggregate_formula": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregate Formula"
        }
      },
      "title": "EligibilityRequirements",
      "type": "object"
    },
    "FacultyItem": {
      "properties": {
        "faculty_name": {
          "title": "Faculty Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "departments": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Departments",
          "type": "array"
        },
        "faculty_website": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Faculty Website"
        }
      },
      "required": [
        "faculty_name"
      ],
      "title": "FacultyItem",
      "type": "object"
    },
    "KeyLinks": {
      "properties": {
        "academics_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Academics Url"
        },
        "admissions_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Admissions Url"
        },
        "application_portal_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PRIMARY FOCUS",
          "title": "Application Portal Url"
        }
      },
      "title": "KeyLinks",
      "type": "object"
    },
    "MainInfo": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "abbreviation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abbreviation"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Country location of the university (e.g. Germany, USA, UK, Switzerland, Pakistan)",
          "title": "Country"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "City location of campus e.g. Islamabad, Munich, Boston",
          "title": "City"
        },
        "established_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Year university was founded",
          "title": "Established Year"
        },
        "accreditation_body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accrediting agency e.g. HEC, ABET, TEQSA, WASC",
          "title": "Accreditation Body"
        },
        "admission_cycles_offered": {
          "description": "Admission terms e.g. Fall, Spring, Summer, Winter",
          "items": {
            "type": "string"
          },
          "title": "Admission Cycles Offered",
          "type": "array"
        },
        "primary_instruction_language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Main teaching language",
          "title": "Primary Instruction Language"
        },
        "website": {
          "title": "Website",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/UniversityType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "domain_verified": {
          "default": false,
          "title": "Domain Verified",
          "type": "boolean"
        },
        "verification_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Note"
        },
        "key_links": {
          "$ref": "#/$defs/KeyLinks"
        },
        "rankings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RankingItem"
          },
          "title": "Rankings",
          "type": "array"
        },
        "exa_enriched": {
          "default": false,
          "title": "Exa Enriched",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "website",
        "description",
        "key_links"
      ],
      "title": "MainInfo",
      "type": "object"
    },
    "ProgramCategoryBlock": {
      "description": "One bucket per DegreeLevel; the key names match the enum values exactly.\n\nPre-C17 the keys were undergraduate / graduate / postgraduate_and_phd, and\nthe last of those did not even match its own enum value\n(\"postgraduate_phd\"). Keys and enum values are now the same four strings, so\na bucket name can be derived from a level rather than translated.",
      "properties": {
        "bachelors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProgramItem"
          },
          "title": "Bachelors",
          "type": "array"
        },
        "masters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProgramItem"
          },
          "title": "Masters",
          "type": "array"
        },
        "phd": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProgramItem"
          },
          "title": "Phd",
          "type": "array"
        },
        "diploma": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProgramItem"
          },
          "title": "Diploma",
          "type": "array"
        }
      },
      "title": "ProgramCategoryBlock",
      "type": "object"
    },
    "ProgramItem": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "program_info_link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Program Info Link"
        },
        "department": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Department"
        },
        "degree_level": {
          "$ref": "#/$defs/DegreeLevel"
        },
        "duration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "tuition_fee": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tuition Fee"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Currency of tuition fee (e.g. EUR, USD, GBP, CHF, PKR)",
          "title": "Currency"
        },
        "scholarships_info": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scholarships Info"
        },
        "intake_terms": {
          "description": "Intake terms for this program e.g. Fall, Spring, Winter",
          "items": {
            "type": "string"
          },
          "title": "Intake Terms",
          "type": "array"
        },
        "delivery_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "On-Campus, Online, or Hybrid",
          "title": "Delivery Mode"
        },
        "application_fee": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Application fee amount and currency",
          "title": "Application Fee"
        },
        "career_prospects": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target career outcomes or roles",
          "title": "Career Prospects"
        },
        "courses_taught": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Courses Taught",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Full-paragraph overview of the programme: focus areas, learning outcomes, career prospects, distinctive features or specializations",
          "title": "Description"
        },
        "summary_3_lines": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary 3 Lines"
        },
        "admission_requirements": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Admission process and requirements beyond raw eligibility marks: documents, interviews, portfolios, prerequisites, entry-test steps",
          "title": "Admission Requirements"
        },
        "eligibility_requirements": {
          "$ref": "#/$defs/EligibilityRequirements"
        },
        "application_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApplicationStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "application_deadlines": {
          "description": "Every published application deadline, one entry per intake",
          "items": {
            "type": "string"
          },
          "title": "Application Deadlines",
          "type": "array"
        }
      },
      "required": [
        "name",
        "degree_level"
      ],
      "title": "ProgramItem",
      "type": "object"
    },
    "RankingItem": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "year": {
          "title": "Year",
          "type": "integer"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        }
      },
      "required": [
        "source",
        "scope",
        "year",
        "rank"
      ],
      "title": "RankingItem",
      "type": "object"
    },
    "SubCampusContact": {
      "properties": {
        "campus_name": {
          "title": "Campus Name",
          "type": "string"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "contact_details": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contact Details"
        }
      },
      "required": [
        "campus_name"
      ],
      "title": "SubCampusContact",
      "type": "object"
    },
    "UniversityType": {
      "enum": [
        "public",
        "private",
        "other"
      ],
      "title": "UniversityType",
      "type": "string"
    }
  },
  "properties": {
    "main_info": {
      "$ref": "#/$defs/MainInfo"
    },
    "programs": {
      "$ref": "#/$defs/ProgramCategoryBlock"
    },
    "faculties": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FacultyItem"
      },
      "title": "Faculties",
      "type": "array"
    },
    "contact": {
      "$ref": "#/$defs/ContactInfo"
    },
    "programs_possibly_truncated": {
      "default": false,
      "title": "Programs Possibly Truncated",
      "type": "boolean"
    },
    "failed_query_blocks": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Failed Query Blocks",
      "type": "array"
    }
  },
  "required": [
    "main_info",
    "programs",
    "contact"
  ],
  "title": "UniversityPayload",
  "type": "object"
}
