  "_meta": {
    "purpose": "Ground-truth university IDENTITY registry, keyed by canonical domain. Supplies main_info identity fields (name, abbreviation, city, type, aliases, established_year, accreditation_body) deterministically so the LLM is never asked to guess them. Rankings are intentionally not part of this pipeline; if added later they belong in a separate, separately-verified file.",
    "schema": {
      "<domain>": {
        "name": "str  -- official registered name",
        "abbreviation": "str | null",
        "city": "str | null",
        "type": "public | private | other",
        "aliases": [
          "alternate domains that resolve to the same institution"
        ]
      }
    }
  },
