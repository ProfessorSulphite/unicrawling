{
  "_meta": {
    "purpose": "Ground-truth university identity and rankings registry, keyed by canonical domain. Supplies main_info identity fields deterministically so the model is never asked to guess them, and supplies rankings, which are otherwise the most confidently hallucinated field in the payload. Consolidated from rankings_pk.json and rankings_global.json in C25.",
    "schema": {
      "<domain>": {
        "name": "str  -- official registered name",
        "abbreviation": "str | null",
        "country": "str",
        "city": "str | null",
        "type": "public | private | other | null",
        "established_year": "int | null",
        "accreditation_body": "str | null",
        "aliases": [
          "alternate domains that resolve to the same institution"
        ],
        "rankings": [
          {
            "source": "QS World University Rankings | THE | Webometrics",
            "scope": "Global | National",
            "subject": "str",
            "year": "int",
            "rank": "int",
            "source_url": "str"
          }
        ]
      }
    },
    "rules": [
      "A domain absent from this file yields no facts; nothing is inferred from the name.",
      "Rankings are never taken from the model -- an entry with no ranking reports none.",
      "aliases resolve subdomains and alternate domains onto the canonical entry."
    ]
  },
