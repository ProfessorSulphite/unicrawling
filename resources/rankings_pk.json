{
  "_meta": {
    "purpose": "Ground-truth registry for Pakistani universities, keyed by canonical domain. Supplies main_info identity fields deterministically so the LLM is never asked to guess them, and supplies rankings so the LLM is never asked to invent a numeric rank.",
    "rankings_status": "UNPOPULATED",
    "rankings_populate_instructions": "Rankings are deliberately empty. Populate from https://www.webometrics.info/en/Asia/Pakistan (national + world rank) and https://www.topuniversities.com/world-university-rankings (QS). Each entry must carry source, scope, year, rank and source_url. Never populate this file from an LLM answer -- numeric ranks are the single most hallucinated field in the payload. Until populated, MainInfo.rankings stays [] and inspect_cli reports 0% ranking coverage, which is the correct and honest signal.",
    "schema": {
      "<domain>": {
        "name": "str  -- official registered name",
        "abbreviation": "str | null",
        "city": "str | null",
        "type": "public | private | other",
        "aliases": ["alternate domains that resolve to the same institution"],
        "rankings": [
          {
            "source": "Webometrics | QS | THE",
            "scope": "world | national | asia",
            "subject": "str | null",
            "year": "int",
            "rank": "int",
            "source_url": "str | null"
          }
        ]
      }
    }
  },
